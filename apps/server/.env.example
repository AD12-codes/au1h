PORT=4444
# production: secure cookies, Better Auth rate limiter, private proxy backends refused
NODE_ENV=development

# better auth
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:4444

# Admin portal origin(s), comma-separated. Used for CORS and trusted origins only;
# the admin portal identifies itself with the x-app-id header, never by Origin.
CORS_ORIGIN=http://localhost:4445

# Reserved x-app-id value the admin portal sends (default: au1h-admin).
# AU1H_ADMIN_APP_SLUG=au1h-admin

# Who may create an admin-portal account. Comma-separated exact emails and/or
# @domains. Also allowed: emails with a pending organization invitation, and the
# very first admin when none exists yet.
AU1H_ADMIN_EMAILS=

# Proxy routes may only target private/loopback backends when this is true.
# Defaults to true outside NODE_ENV=production, false in production.
# AU1H_PROXY_ALLOW_PRIVATE_BACKENDS=false

# Backend fetch timeout for proxied requests (ms). Default 30000.
# AU1H_PROXY_TIMEOUT_MS=30000

# Rate limits per client IP per minute (Redis-backed, shared across instances).
# AU1H_RATE_LIMIT_ADMIN=300    # /api/v1/*
# AU1H_RATE_LIMIT_PROXY=600    # /proxy/*  (per IP + app slug)
# AU1H_RATE_LIMIT_APPS=600     # /api/apps/* (per IP + app slug)
# Better Auth's own limiter on /api/auth/* (strict defaults: 3 sign-ins / 10 s / IP).
# Defaults to on in production and off otherwise; set true/false to override.
# AU1H_AUTH_RATE_LIMIT=true
# Honour x-forwarded-for for rate limiting only when behind a trusted proxy.
# AU1H_TRUST_PROXY=false

# Dev-only: skip the OAuth state cookie check (cross-port localhost). Never in production.
# AU1H_SKIP_OAUTH_STATE_CHECK=false

# Log level (default: debug outside production, info in production).
# LOG_LEVEL=info

# database URLS
DATABASE_URL=

# redis URL
REDIS_URL=redis://localhost:6379

# social providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Email (verification, password reset, magic link, one-time codes) ----
# console (default): messages are logged, nothing is sent. smtp | resend deliver.
EMAIL_PROVIDER=console
# Sender address; the application name is used as the display name.
EMAIL_FROM_ADDRESS=no-reply@example.com
# SMTP_URL=smtps://user:password@smtp.example.com:465
# RESEND_API_KEY=re_...
# Send a verification email on every sign-up (default true) and refuse
# sign-in until verified (default false).
AU1H_SEND_VERIFICATION_ON_SIGNUP=true
AU1H_REQUIRE_EMAIL_VERIFICATION=false

# ------------------------------------------------------------------------------
# TESTS
# ------------------------------------------------------------------------------
# `bun run test:integration` needs Postgres + Redis. Point it at a throwaway
# database so it never touches your dev data (it runs the migrations itself).
# AU1H_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/au1h_test
