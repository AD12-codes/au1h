{
  "name": "server",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/db/migrate.ts && bun run src/index.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "bun test",
    "test:integration": "AU1H_INTEGRATION_TESTS=1 LOG_LEVEL=silent bun test integration",
    "migrate": "bun run src/db/migrate.ts"
  },
  "dependencies": {
    "better-auth": "1.3.34",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.8.2",
    "ioredis": "^5.8.2",
    "jose": "^6",
    "nodemailer": "^10.2.1",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/bun": "^1.2.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.6",
    "tsdown": "0.16.2",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
