{
  "name": "@au1h/client",
  "version": "0.1.1",
  "description": "Browser/client SDK for au1h: Better Auth client preconfigured for your application, plus JWT and proxy helpers.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./react": {
      "types": "./dist/react.d.mts",
      "import": "./dist/react.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit -p ."
  },
  "peerDependencies": {
    "better-auth": "^1.3.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "better-auth": "1.3.34",
    "react": "19.2.3",
    "@types/react": "^19.2.7",
    "tsdown": "0.16.2",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AD12-codes/au1h.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/AD12-codes/au1h",
  "publishConfig": {
    "access": "public"
  }
}
