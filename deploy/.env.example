# Variables for docker-compose.yml and deploy/docker-compose.ghcr.yml.

# Postgres password for the bundled database service
POSTGRES_PASSWORD=change-me

# Long random string; signs cookies and encrypts the JWT private key.
# Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me

# Public URL of the server. The admin portal reads it at start (AU1H_SERVER_URL).
BETTER_AUTH_URL=https://api.example.com

# Admin portal origin (CORS + trusted origin)
CORS_ORIGIN=https://app.example.com

# Who may sign up as an admin after the first one. Comma-separated emails / @domains.
AU1H_ADMIN_EMAILS=you@example.com

# Only set to true if your app backends live on this host's private network.
AU1H_PROXY_ALLOW_PRIVATE_BACKENDS=false

# Optional OAuth providers (callback: ${BETTER_AUTH_URL}/api/auth/callback/<provider>)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

LOG_LEVEL=info

# Image tag for deploy/docker-compose.ghcr.yml: latest or a commit SHA
AU1H_IMAGE_TAG=latest
